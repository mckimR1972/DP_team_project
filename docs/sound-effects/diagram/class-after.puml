@startuml class-after
!pragma layout smetana
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam classAttributeIconSize 0
hide circle
set separator none
hide empty members
skinparam ranksep 60
skinparam nodesep 45
title 사운드를 붙인 뒤: 게임과 사운드의 연결 (dev 838182c)

package "com.holub.life" {
  class Life {
    - Life()
  }

  class Universe <<Subject>> {
    - outermostCell : Cell
    - boardListeners : Set<BoardChangeListener>
    - generation : long
    - playhead : int = -1
    + {static} instance() : Universe
    + addBoardChangeListener(listener : BoardChangeListener)
    + removeBoardChangeListener(listener : BoardChangeListener)
    + liveCells() : boolean[][]
    + widthInCells() : int
    + setPlayhead(column : int)
    - notifyBoardChanged(kind : Kind, before : boolean[][])
  }

  interface BoardChangeListener <<Observer>> {
    + onBoardChanged(event : BoardChangeEvent)
  }

  class BoardChangeEvent {
    - kind : Kind
    - generation : long
    - aliveCells : boolean[][]
    - births : List<Point>
    - deaths : List<Point>
    - aliveColors : List<Color>
    + kind() : Kind
    + generation() : long
    + copyAliveCells() : boolean[][]
    + copyBirths() : List<Point>
    + copyDeaths() : List<Point>
  }

  enum "BoardChangeEvent.Kind" as Kind {
    INITIAL
    GENERATION
    EDIT
    TEMPLATE
    TEMPLATE_UNDO
    CLEAR
    LOAD
    COLOR_POLICY_CHANGED
  }

  class Statistics <<ConcreteObserver>> {
    + onBoardChanged(event : BoardChangeEvent)
  }

  interface Cell <<Component>> {
    + isAlive() : boolean
    + **isAliveAt(row : int, column : int) : boolean**
    + widthInCells() : int
    + transition() : boolean
  }

  class Neighborhood <<Composite>> {
    - grid : Cell[][]
    + **isAliveAt(row : int, column : int) : boolean**
  }

  class Resident <<Leaf>> {
    - amAlive : boolean
    + **isAliveAt(row : int, column : int) : boolean**
  }
}

package "com.holub.life.sound" {
  class SoundEffects <<ConcreteObserver>> {
    + {static} install(universe : Universe)
    + onBoardChanged(event : BoardChangeEvent)
  }
}

Life ..> Universe
Life ..> SoundEffects : install(universe)

Universe o-- "*" BoardChangeListener : boardListeners
Universe ..> BoardChangeEvent : <<create>>
BoardChangeEvent +-- Kind
BoardChangeListener <|.. Statistics
BoardChangeListener <|.. SoundEffects
SoundEffects ..> BoardChangeEvent : 판 복사본, 생성·소멸 좌표
SoundEffects --> "1" Universe : 재생선 표시 (setPlayhead)

Universe --> "1" Cell : outermostCell
Cell <|.. Neighborhood
Cell <|.. Resident
Neighborhood o-- "64" Cell : grid (8×8)

note top of Universe
  Observer의 Subject.
  BoardChangeListener만 알고
  사운드 패키지는 import하지 않는다.
end note

note bottom of Neighborhood
  Composite 확장: isAliveAt()은 좌표를
  하위 격자 위치와 나머지로 나눠
  해당 하위 셀에 넘긴다.
end note

legend right
  굵은 글씨: 사운드 작업에서 추가한 연산
  리스너 구조는 처음(#3)에는 GenerationListener였고
  통계 기능(#10)에서 BoardChangeListener로 합쳐졌다.
endlegend
@enduml
