@startuml usecase
!pragma layout smetana
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam usecaseBackgroundColor #F1F1F1
left to right direction

actor "사용자" as User

rectangle "Life Game" {
  usecase "Run / Halt Game" as Run
  usecase "Step One Generation" as Step

  usecase Adv as "Advance Generation
--
extension points
세대 확정 후"

  usecase "Hear Generation Sound(E)" as Gen
  usecase "Hear Board Sweep(E)" as Sweep
  usecase "Toggle Sound(E)" as Toggle
  usecase "Configure Sound(E)" as Config
}

User -- Run
User -- Step
User -- Sweep
User -- Toggle
User -- Config

Run ..> Adv : <<include>>
Step ..> Adv : <<include>>
Adv <.. Gen : <<extend>>
note top on link
  condition: {소리가 켜져 있음}
  extension point: 세대 확정 후
end note
@enduml
