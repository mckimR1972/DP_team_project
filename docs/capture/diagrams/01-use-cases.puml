@startuml
!include theme.puml
left to right direction
skinparam nodesep 30
skinparam ranksep 45
actor "게임 사용자" as User
rectangle "Life Game" {
  usecase "Edit Cells" as Edit
  usecase "Capture Template(E)" as Capture
  usecase Place as "Place Template(E)
--
extension points
반복 배치"
  usecase "Place Template Continuously(E)" as Stroke
  usecase "Undo Placement(E)" as Undo
  usecase "Finish Template Editing(E)" as Finish
}
User -- Edit
User -- Capture
User -- Place
User -- Undo
User -- Finish
Place <.. Stroke : <<extend>>
note top on link
  condition: {왼쪽 버튼을 유지하거나 드래그함}
  extension point: 반복 배치
end note
@enduml
