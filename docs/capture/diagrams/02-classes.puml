@startuml
!include theme.puml
hide empty members
class PatternTools {
  -mode : Mode
  -stampTimer : Timer
  ~setPlacementGuard(guard : Predicate<Rectangle>) : void
}
class BoardEditor {
  +capture(name : String, area : Rectangle) : PatternTemplate
  +place(pattern : PatternTemplate, origin : Point) : boolean
  +beginStroke() : void
  +endStroke() : boolean
  +undo() : void
}
class PatternLibrary {
  +save(pattern : PatternTemplate) : void
  +patterns() : List<PatternTemplate>
}
class PatternTemplate {
  -name : String
  -cells : boolean[][]
}
class PlacePatternCommand {
  -added : Set<Point>
  ~execute() : boolean
  ~undo() : void
  ~include(next : PlacePatternCommand) : void
}
class PatternCells {
  ~isAlive(cell : Point) : boolean
  ~setAlive(cell : Point, alive : boolean) : boolean
}
class PatternPath {
  {static} ~visit(from : Point, to : Point, visitor : Consumer<Point>) : void
}
interface Cell <<interface>> {
  +isAliveAt(row : int, column : int) : boolean
  +userClicked(here : Point, surface : Rectangle) : void
  +createMemento() : Storable
}
class Neighborhood
class Resident

PatternTools "1" --> "1" BoardEditor : editor
PatternTools "1" --> "1" PatternLibrary : library
PatternTools ..> PatternPath : <<use>>
PatternLibrary "1" --> "0..*" PatternTemplate : patterns
BoardEditor ..> PatternTemplate : <<create>>
BoardEditor "1" --> "0..100" PlacePatternCommand : history
PlacePatternCommand "1" --> "1" PatternCells : cells
PatternCells "0..*" --> "1" Cell : board
BoardEditor "0..*" --> "1" Cell : board
Neighborhood ..|> Cell
Resident ..|> Cell
Neighborhood "1" *-- "64" Cell : grid
note bottom of Neighborhood
  현재 게임: gridSize = 8 (8 × 8 = 64)
  생성자는 다른 gridSize도 지원한다.
end note
@enduml
