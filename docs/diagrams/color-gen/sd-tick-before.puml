@startuml sd-tick-before
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam sequenceMessageAlign center
hide footbox
mainframe sd tick (원본 dev c49ca39)

participant ":Clock" as C
participant ":Universe" as U
participant "outermostCell : Neighborhood" as N
participant ":Resident" as R

[o-> C : 시간 이벤트
C -> U : tick()
U -> N : figureNextState(DUMMY × 8)
loop 활성 블록의 칸마다
  N -> R : figureNextState(이웃 8칸)
end
N --> U : willChange

opt willChange
  U -> N : transition()
  loop 모든 블록의 칸마다
    N -> R : transition()
    R -> R : amAlive = willBeAlive
    R --> N : changed
  end
  N --> U : changed
  opt changed
    U -> U : refreshNow()
  end
end
@enduml
