@startuml class-after
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam classAttributeIconSize 0
hide circle
skinparam ranksep 70
skinparam nodesep 60

interface Cell <<interface>> {
  + figureNextState(이웃 8칸 : Cell) : boolean
  + transition() : boolean
  + redraw(g : Graphics, here : Rectangle, drawAll : boolean)
  + userClicked(here : Point, surface : Rectangle)
  + transfer(memento : Storable, upperLeft : Point, doLoad : boolean) : boolean
  + colorAt(row : int, column : int) : Color
  + create() : Cell
}

class Neighborhood {
  - gridSize : int
  + transition() : boolean
  + redraw(g : Graphics, here : Rectangle, drawAll : boolean)
}

class Resident {
  ~ {static} LIVE_COLOR : Color = Color.RED
  - amAlive : boolean
  - willBeAlive : boolean
  - age : int = 0
  ~ {static} setColorPolicy(policy : CellColorPolicy)
  ~ {static} colorChangesWithAge() : boolean
  + transition() : boolean
  + redraw(g : Graphics, here : Rectangle, drawAll : boolean)
  + userClicked(here : Point, surface : Rectangle)
  + transfer(memento : Storable, upperLeft : Point, doLoad : boolean) : boolean
  + colorAt(row : int, column : int) : Color
}

interface CellColorPolicy <<interface>> {
  + colorOf(age : int) : Color
  + changesWithAge() : boolean
}

class FixedColorPolicy {
  - color : Color
  + FixedColorPolicy(color : Color)
  + colorOf(age : int) : Color
  + changesWithAge() : boolean
}

class CyclingColorPolicy {
  - period : int
  - colors : Color[2..*]
  + CyclingColorPolicy(period : int, colors : Color[2..*])
  + colorOf(age : int) : Color
  + changesWithAge() : boolean
}

class Universe {
  - {static} theInstance : Universe
  + {static} instance() : Universe
  # paintComponent(g : Graphics)
  - refreshNow()
  - useColorPolicy(policy : CellColorPolicy)
}

class Clock {
  + {static} instance() : Clock
  + addClockListener(observer : Listener)
}

Cell <|... Neighborhood
Cell <|.. Resident
Neighborhood "1" *-up-> "64" Cell : - grid
Neighborhood -[hidden]right- Resident
Universe --> "1" Cell : - outermostCell
Universe ..> Clock : 틱 리스너 등록
Universe ..> Resident : 프로토타입 생성,\n규칙 교체와 질의
CellColorPolicy <|.. FixedColorPolicy
CellColorPolicy <|.. CyclingColorPolicy
Resident -right-> "1" CellColorPolicy : - <u>colorPolicy</u>
Universe ..> FixedColorPolicy : <<create>>
Universe ..> CyclingColorPolicy : <<create>>

note top of CellColorPolicy : Strategy
note bottom of FixedColorPolicy : ConcreteStrategy
note bottom of CyclingColorPolicy : ConcreteStrategy
note bottom of Resident
  Context
  redraw()와 colorAt()이
  colorPolicy.colorOf(age)로 색을 받는다.
  colorAt()은 통계 기능(#10)이 더했다
end note
note right of Universe
  Client
  Color 메뉴에서 규칙을 만들어
  useColorPolicy()로 바꿔 끼운다
end note
@enduml
