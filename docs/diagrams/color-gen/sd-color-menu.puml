@startuml sd-color-menu
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam sequenceMessageAlign center
hide footbox
mainframe sd Color > Cycle by Generation

actor "사용자" as User
participant "item : JMenuItem" as M
participant "listener : ActionListener" as L
participant ":Universe" as U
participant "Resident" as RC
participant "outermostCell : Neighborhood" as N
participant ":Resident" as R

User -> M : 클릭
M -> L : actionPerformed(e)
create participant "policy : CyclingColorPolicy" as P
L -> P : <<create>>\n(10, 빨강, 파랑, 초록)
L -> U : useColorPolicy(policy)
U -> RC : setColorPolicy(policy)
note left of RC : static 메서드라\n클래스에 보낸다
RC -> RC : colorPolicy = policy
U -> U : notifyBoardChanged(COLOR_POLICY_CHANGED)
U -> U : repaint()

== 이벤트 큐에서 차례가 오면 ==

[o-> U : paintComponent(g)
U -> N : redraw(g, 판, true)
loop 모든 블록의 칸마다
  N -> R : redraw(g, 칸, true)
  opt amAlive
    R -> P : colorOf(age)
    P --> R : color
  end
end
@enduml
