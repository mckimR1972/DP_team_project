// 전체 유스케이스. 자동 배치 대신 좌표(pos)를 직접 정했다.
// 그리기: neato -n2 -Tpng -Gdpi=150 usecase.gv -o usecase.png
graph usecase {
  graph [splines=line, outputorder=edgesfirst, pad=0.2];
  node [fontname="Malgun Gothic", fontsize=11];
  edge [penwidth=1.0];

  // 시스템 경계와 기능 묶음
  boundary [shape=box, label=<<b>Life Game</b>>, labelloc=t, fontsize=12, width=11.867, height=14.847, fixedsize=true, pos="687.8,-54.5!"];
  pkgt0 [shape=plaintext, label=<<b>색 순환</b>>, pos="384.5,427.0!"];
  pkg0 [shape=box, label="", width=8.667, height=1.889, fixedsize=true, pos="666.0,372.0!"];
  pkgt1 [shape=plaintext, label=<<b>드래그 그리기</b>>, pos="437.9,276.0!"];
  pkg1 [shape=box, label="", width=3.167, height=1.222, fixedsize=true, pos="504.1,245.0!"];
  pkgt2 [shape=plaintext, label=<<b>기존 기능</b>>, pos="452.2,164.0!"];
  pkg2 [shape=box, label="", width=7.472, height=4.556, fixedsize=true, pos="685.0,13.0!"];
  pkgt3 [shape=plaintext, label=<<b>영역 캡처·템플릿</b>>, pos="434.5,-190.0!"];
  pkg3 [shape=box, label="", width=3.167, height=2.556, fixedsize=true, pos="491.8,-269.0!"];
  pkgt4 [shape=plaintext, label=<<b>사운드</b>>, pos="327.8,-398.0!"];
  pkg4 [shape=box, label="", width=6.722, height=2.556, fixedsize=true, pos="542.6,-477.0!"];

  // 유스케이스
  On [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Turn On Color Cycling E", width=2.778, height=0.472, fixedsize=true, pos="468.0,383.0!"];
  Off [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Turn Off Color Cycling E", width=2.778, height=0.472, fixedsize=true, pos="468.0,335.0!"];
  Count [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Count Cell Age E", width=2.778, height=0.472, fixedsize=true, pos="724.0,335.0!"];
  Recolor [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Recolor Cells by Age E", width=2.778, height=0.472, fixedsize=true, pos="864.0,383.0!"];
  Drag [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Draw Cells by Dragging E", width=2.778, height=0.472, fixedsize=true, pos="504.1,232.0!"];
  Edit [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Edit Cells", width=2.778, height=0.472, fixedsize=true, pos="530.0,120.0!"];
  Run [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Run / Halt Game", width=2.778, height=0.472, fixedsize=true, pos="530.0,72.0!"];
  Step [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Step One Generation", width=2.778, height=0.472, fixedsize=true, pos="530.0,24.0!"];
  Clear [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Clear Board", width=2.778, height=0.472, fixedsize=true, pos="530.0,-24.0!"];
  StoreLoad [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Store / Load Board", width=2.778, height=0.472, fixedsize=true, pos="530.0,-72.0!"];
  Exit [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Exit Game", width=2.778, height=0.472, fixedsize=true, pos="530.0,-120.0!"];
  Advance [shape=ellipse, style=filled, fillcolor="#F1F1F1", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td>Advance Generation</td></tr><hr/><tr><td><font point-size="10">extension points<br/>세대 확정 후</font></td></tr></table>>, width=3.056, height=0.889, fixedsize=true, pos="830.0,48.0!"];
  Capture [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Capture Template E", width=2.778, height=0.472, fixedsize=true, pos="491.8,-234.0!"];
  Place [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Place Template E", width=2.778, height=0.472, fixedsize=true, pos="491.8,-282.0!"];
  Undo [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Undo Placement E", width=2.778, height=0.472, fixedsize=true, pos="491.8,-330.0!"];
  Toggle [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Toggle Sound E", width=2.778, height=0.472, fixedsize=true, pos="414.6,-442.0!"];
  Config [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Configure Sound E", width=2.778, height=0.472, fixedsize=true, pos="414.6,-490.0!"];
  Sweep [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Hear Board Sweep E", width=2.778, height=0.472, fixedsize=true, pos="414.6,-538.0!"];
  GenSound [shape=ellipse, style=filled, fillcolor="#F1F1F1", label="Hear Generation Sound E", width=2.778, height=0.472, fixedsize=true, pos="670.6,-442.0!"];

  // 액터 (막대 인형)
  a_head [shape=circle, label="", width=0.25, height=0.25, fixedsize=true, pos="40.0,36.0!"];
  a_body [shape=point, width=0.01, style=invis, pos="40.0,27.0!"];
  a_hip [shape=point, width=0.01, style=invis, pos="40.0,-8.0!"];
  a_larm [shape=point, width=0.01, style=invis, pos="24.0,10.0!"];
  a_rarm [shape=point, width=0.01, style=invis, pos="56.0,10.0!"];
  a_lleg [shape=point, width=0.01, style=invis, pos="27.0,-30.0!"];
  a_rleg [shape=point, width=0.01, style=invis, pos="53.0,-30.0!"];
  anchor [shape=point, width=0.01, style=invis, pos="58.0,4.0!"];
  a_body -- a_hip; a_larm -- a_rarm; a_hip -- a_lleg; a_hip -- a_rleg;
  a_label [shape=plaintext, label="사용자", fontsize=12, pos="40.0,-46.0!"];

  // 액터와 유스케이스의 연관
  anchor -- On:w;
  anchor -- Off:w;
  anchor -- Drag:w;
  anchor -- Edit:w;
  anchor -- Run:w;
  anchor -- Step:w;
  anchor -- Clear:w;
  anchor -- StoreLoad:w;
  anchor -- Exit:w;
  anchor -- Capture:w;
  anchor -- Place:w;
  anchor -- Undo:w;
  anchor -- Toggle:w;
  anchor -- Config:w;
  anchor -- Sweep:w;

  // 포함·확장 (화살표와 이름을 따로 둔다)
  Drag -- Edit [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel0 [shape=plaintext, label="«extend»", fontsize=10, pos="561.1,190.0!"];
  On -- Recolor [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel1 [shape=plaintext, label="«include»", fontsize=10, pos="606.0,396.0!"];
  Run -- Advance [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel2 [shape=plaintext, label="«include»", fontsize=10, pos="676.0,74.0!"];
  Step -- Advance [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel3 [shape=plaintext, label="«include»", fontsize=10, pos="676.0,21.0!"];
  Count -- Advance [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel4 [shape=plaintext, label="«extend»", fontsize=10, pos="737.0,191.5!"];
  Recolor -- Advance [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel5 [shape=plaintext, label="«extend»", fontsize=10, pos="893.0,287.5!"];
  GenSound -- Advance [style=dashed, dir=forward, arrowhead=vee, arrowsize=0.8];
  rel6 [shape=plaintext, label="«extend»", fontsize=10, pos="708.3,-197.0!"];

  // 확장 조건 노트
  note0 [shape=note, label="condition: {색 순환이 켜져 있음}\lextension point: 세대 확정 후\l", fontsize=10, width=2.778, height=0.556, fixedsize=true, pos="985.0,242.0!"];
  notep0 [shape=point, width=0.01, style=invis, pos="849.7,242.0!"];
  note0 -- notep0 [style=dashed];
  note1 [shape=note, label="condition: {소리가 켜져 있음}\lextension point: 세대 확정 후\l", fontsize=10, width=2.778, height=0.556, fixedsize=true, pos="900.0,-250.0!"];
  notep1 [shape=point, width=0.01, style=invis, pos="733.0,-250.0!"];
  note1 -- notep1 [style=dashed];
}
