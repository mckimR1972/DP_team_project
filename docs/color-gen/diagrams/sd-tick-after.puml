@startuml sd-tick-after
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam sequenceMessageAlign center
hide footbox
mainframe sd advanceGeneration()

participant ":Clock" as C
participant ":Universe" as U
participant "freezing : FreezingManager" as F
participant "outermostCell : Neighborhood" as N
participant ":Resident" as R
participant "Resident" as RC
participant "colorPolicy : CellColorPolicy" as P

[o-> C : tick()
C -> U : tick()

alt 캡처·배치 편집 중 또는 Freezing 영역 선택 중
  U -->> C
else else
  U -> N : figureNextState(DUMMY × 8)
  loop 계산할 블록의 칸마다
    N -> R : figureNextState(이웃 8칸)
    note right of R : 활성 블록, 또는 맞닿은 가장자리가\n바뀐 이웃 블록만 계산한다
  end
  U -> U : before = liveCells()

  U -> F : beforeTransition(outermostCell)
  loop 고정된 영역의 칸마다
    F -> N : holdNextState(칸, 스냅샷)
    N -> R : holdNextState(칸, 스냅샷)
    note right of R : willBeAlive = 스냅샷\nheldThisGeneration = true
  end

  U -> N : transition()
  loop 모든 블록의 칸마다
    N -> R : transition()
    note right of R : heldThisGeneration이 아니면\nage = (전후 모두 생존) ? age + 1 : 0\nheldThisGeneration = false\namAlive = willBeAlive
    R -->> N : changed = transition(): boolean
  end
  N -->> U : changed = transition(): boolean
  note right of U : generation++

  U -> F : afterGeneration()
  note right of F : 남은 세대를 줄이고\n0이 된 영역은 고정을 푼다
  U -> U : notifyBoardChanged(GENERATION, before)

  U -> RC : colorChangesWithAge()
  note left of RC : static 메서드라\n클래스에 보낸다
  RC -> P : changesWithAge()
  P -->> RC : withAge = changesWithAge(): boolean
  RC -->> U : withAge = colorChangesWithAge(): boolean
  opt withAge 또는 changed
    U ->> U : refreshNow()
  end
end
note over F, N : FreezingManager는 영역마다 상태 객체(State 패턴)에 묻고,\nFrozen 상태인 영역만 스냅샷을 되돌린다. 그림에서는 이 단계를 줄였다
@enduml
