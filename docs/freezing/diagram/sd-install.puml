@startuml sd-install
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam sequenceMessageAlign center
hide footbox
mainframe sd Install Freezing E

actor "사용자" as User
participant ":FreezingTools" as T
participant ":FreezingManager" as M
participant "board : Cell" as B

User -> T : Freezing 설치 클릭
T -> T : installSelection()
T -> M : install(selection, generations)
M -> M : 영역을 보드에 맞춰 자름

alt 빈 영역이거나 기존 영역과 겹침
  M --> T : IllegalArgumentException
  T -> T : message(e.getMessage())
  note right of T
    화면에서는 겹치면 설치 버튼이 꺼지고
    선택은 항상 보드 안이라 보통 오지 않는다.
    모델이 막는 방어 경로다
  end note
else
  create participant "region : FreezingRegion" as R
  M -> R : <<create>>(area)
  M -> R : freeze(board, generations, generation())
  create participant "frozen : FrozenState" as F
  R -> F : <<create>>(generations)
  note right of F : generations < 1이면\n여기서 예외
  loop 영역의 칸마다
    R -> B : isAliveAt(row, column)
    B --> R : alive
  end
  R -> R : changeState(frozen)
  M -> M : regions.add(region)
  M -> T : refresh()
  note left : addListener()로 등록한\nRunnable
  M --> T : region
  T -> T : selecting = false
end
@enduml
