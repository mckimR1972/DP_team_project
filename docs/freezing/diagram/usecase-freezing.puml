@startuml usecase-freezing
!pragma layout smetana
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam usecaseBackgroundColor #F1F1F1
left to right direction

actor "사용자" as User

rectangle "Life Game" {
  usecase "Install Freezing E" as Install
  usecase "Select Region E" as Region
  usecase "Set Duration E" as Duration
  usecase "Release Freezing E" as Release
  usecase "Run / Halt Game" as Run
  usecase "Step One Generation" as Step

  usecase Advance as "Advance Generation
--
extension points
세대 확정 후"

  usecase "Auto Release E" as Auto
}

User -- Install
User -- Release
User -- Run
User -- Step

Install ..> Region : <<include>>
Install ..> Duration : <<include>>
Run ..> Advance : <<include>>
Step ..> Advance : <<include>>
Advance <.. Auto : <<extend>>
note on link
  condition: {남은 세대가 0}
  extension point: 세대 확정 후
end note
@enduml
