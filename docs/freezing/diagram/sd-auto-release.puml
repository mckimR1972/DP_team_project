@startuml sd-auto-release
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam sequenceMessageAlign center
hide footbox
mainframe sd Auto Release E

participant ":Clock" as C
participant ":Universe" as U
participant ":PatternTools" as P
participant "outermostCell : Cell" as B
participant ":FreezingManager" as M
participant "region : FreezingRegion" as R
participant "state : FrozenState" as F
participant ":FreezingTools" as T

C -> U : tick()
alt 패턴 편집 중이거나 영역 선택 중
  U --> C : 바로 return (세대 진행 없음)
else
U -> P : boardChanged()
note right of P : 되돌리기 이력 비움
U -> B : figureNextState(...)
U -> U : before = liveCells()
U -> M : beforeTransition(outermostCell)
loop 영역마다
  M -> R : beforeTransition(cells)
  R -> F : beforeTransition(region, board)
  F -> R : holdSnapshot(board)
  loop 영역의 칸마다
    R -> B : holdNextState(location, snapshot[y][x])
  end
end
note right of R : 목록에는 고정 중인 영역만 있다.\n풀린 영역은 afterGeneration()에서 빠진다
U -> B : transition()
U -> U : generation++

U -> M : afterGeneration()
loop 영역마다
  M -> R : afterGeneration()
  R -> F : afterGeneration(region)
  F -> F : --remaining
  opt remaining <= 0
    F -> R : changeState(NormalState.INSTANCE)
  end
end
M -> M : regions.removeIf(풀린 영역)
M -> T : refresh()
note right : addListener()로 등록한\nRunnable
U -> U : notifyBoardChanged(GENERATION, before)
end
note over U, T
  생략: 다시 그리기(refreshNow), 통계·사운드가 받는 이벤트 처리
end note
@enduml
