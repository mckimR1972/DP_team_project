@startuml class-freezing
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 50
hide circle
hide empty members

' Freezing 전체 클래스 다이어그램
' - 3.3절 시퀀스 다이어그램에 나오는 클래스와 메시지를 모두 담았다.
' - 다른 담당 기능의 클래스(PatternTools, BoardEditor)는 이름만 둔다. docs/uml-conventions.md 1절
' - 연관은 양쪽 끝 다중성, 역할 이름은 필드 이름(가시성 기호 없음). 반환 타입 void는 적지 않는다.
' - FrozenState, NormalState는 FreezingState의 연산 네 개를 모두 구현한다. 같은 연산을 반복하지 않으려고 칸에 적지 않았다.

' ---------------------------------------------------------------- 화면과 연결
class Life {
  ~ {static} createSidebar(universe : Universe, statisticsPanel : StatisticsPanel) : JTabbedPane
}

class Universe {
  - generation : long
  ~ freezingControls() : JPanel
  ~ finishFreezingEditing()
  - setCell(cell : Point, alive : boolean) : boolean
}

class Clock {
  + {static} instance() : Clock
  + stop()
}

class PatternTools
class BoardEditor

class FreezingTools {
  - beforeSelect : Runnable
  - duration : JSpinner
  - selecting : boolean
  - selection : Rectangle
  ~ beginSelection()
  ~ cancel()
  ~ reset()
  ~ isEditing() : boolean
  ~ manager() : FreezingManager
  ~ blockedEdit()
  ~ paintOverlay(g : Graphics2D)
  - selectThrough(end : Point)
  - installSelection()
  - refresh()
}

' ---------------------------------------------------------------- 모델 (Swing 없음)
class FreezingManager {
  - currentGeneration : LongSupplier
  - listeners : List<Runnable>
  ~ install(selected : Rectangle, generations : int) : FreezingRegion
  ~ release(region : FreezingRegion)
  ~ releaseAll()
  ~ reset()
  ~ beforeTransition(cells : Cell) : boolean
  ~ afterGeneration()
  ~ isFrozen(cell : Point) : boolean
  ~ overlapsFrozen(area : Rectangle) : boolean
  ~ addListener(listener : Runnable)
}

class FreezingRegion {
  - area : Rectangle
  - snapshot : boolean[][]
  ~ freeze(board : Cell, generations : int)
  ~ release()
  ~ beforeTransition(board : Cell) : boolean
  ~ afterGeneration()
  ~ changeState(next : FreezingState)
  ~ holdSnapshot(board : Cell) : boolean
  ~ isFrozen() : boolean
}

interface FreezingState <<interface>> {
  + beforeTransition(region : FreezingRegion, board : Cell) : boolean
  + afterGeneration(region : FreezingRegion)
  + isFrozen() : boolean
  + remainingGenerations() : int
}

class FrozenState {
  - remaining : int
  ~ FrozenState(generations : int)
}

class NormalState {
  ~ {static} INSTANCE : NormalState
}

' ---------------------------------------------------------------- 판 (원본 Composite)
interface Cell <<interface>> {
  + transition() : boolean
  + isAliveAt(row : int, column : int) : boolean
  + holdNextState(location : Point, alive : boolean) : boolean
}

class Neighborhood {
  + holdNextState(location : Point, alive : boolean) : boolean
}

class Resident {
  - amAlive : boolean
  - willBeAlive : boolean
  - heldThisGeneration : boolean
  + transition() : boolean
  + holdNextState(location : Point, alive : boolean) : boolean
}

' ---------------------------------------------------------------- 관계
Life "1" -right-> "1" Universe : universe
Universe "1" -right-> "1" PatternTools : patternTools
PatternTools "1" -right-> "1" BoardEditor : editor
Universe "1" --> "1" FreezingTools : freezingTools
Universe ..> FreezingManager : <<create>>\n<<use>>
Universe "1" --> "1" Cell : outermostCell

FreezingTools .left.> Clock : <<use>>
FreezingTools "1" -right-> "1" FreezingManager : manager
FreezingTools "1" --> "0..*" FreezingRegion : entries

FreezingManager "1" o--> "0..*" FreezingRegion : regions
FreezingManager "0..1" -right-> "1" Cell : board

FreezingRegion "0..*" -left-> "1" FreezingState : state
FreezingRegion ..> FrozenState : <<create>>
FreezingRegion ..> Cell : <<use>>
FreezingState <|.. FrozenState
FreezingState <|.. NormalState
FrozenState ..> FreezingRegion : <<use>>

Cell <|.. Neighborhood
Cell <|.. Resident
Neighborhood "1" *-- "64" Cell : grid

' ---------------------------------------------------------------- 패턴 역할 (짧게)
note top of Universe
  Mediator: FreezingTools, PatternTools, 시계 틱을 잇는다.
  배치 가드(Predicate)와 beforeSelect(Runnable)만 넘긴다
end note

note top of FreezingManager
  Observer의 Subject: 영역 목록이 바뀌면
  listeners(FreezingTools.refresh)를 부른다
end note

note bottom of FreezingRegion
  State의 Context:
  고정 여부를 묻지 않고 state에 넘긴다
end note

note bottom of FrozenState
  ConcreteState: 남은 세대가 0이 되면
  region.changeState(NormalState.INSTANCE)
end note
@enduml
