@startuml class-freezing
skinparam monochrome true
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam classAttributeIconSize 0
hide circle
hide empty members
skinparam ranksep 70
skinparam nodesep 60

interface Cell <<interface>> {
  + figureNextState(north : Cell, south : Cell, east : Cell, west : Cell,\n    northeast : Cell, northwest : Cell, southeast : Cell, southwest : Cell) : boolean
  + transition() : boolean
  + isAliveAt(row : int, column : int) : boolean
  + holdNextState(location : Point, alive : boolean) : boolean
  + widthInCells() : int
}

class Neighborhood {
  + transition() : boolean
  + holdNextState(location : Point, alive : boolean) : boolean
}

class Resident {
  - amAlive : boolean
  - willBeAlive : boolean
  - heldThisGeneration : boolean
  + transition() : boolean
  + holdNextState(location : Point, alive : boolean) : boolean
}

class Universe {
  - generation : long
  ~ freezingControls() : JPanel
  ~ finishFreezingEditing()
  - setCell(cell : Point, alive : boolean) : boolean
  # paintComponent(g : Graphics)
}

class Clock {
  + {static} instance() : Clock
  + stop()
}

class Life {
  ~ {static} createSidebar(universe : Universe, statisticsPanel : StatisticsPanel) : JTabbedPane
}

class PatternTools

class FreezingTools {
  - beforeSelect : Runnable
  - selecting : boolean
  - anchor : Point
  - selection : Rectangle
  - duration : JSpinner
  ~ beginSelection()
  ~ cancel()
  ~ reset()
  ~ isEditing() : boolean
  ~ blockedEdit()
  ~ paintOverlay(g : Graphics2D)
  - installSelection()
  - refresh()
}

class FreezingManager {
  - currentGeneration : LongSupplier
  - listeners : List<Runnable>
  ~ install(selected : Rectangle, generations : int) : FreezingRegion
  ~ release(region : FreezingRegion)
  ~ releaseAll()
  ~ reset()
  ~ beforeTransition(cells : Cell) : boolean
  ~ afterGeneration()
  ~ isFrozen(cell : Point) : boolean
  ~ overlapsFrozen(area : Rectangle) : boolean
  ~ addListener(listener : Runnable)
}

class FreezingRegion {
  - area : Rectangle
  - snapshot : boolean[][]
  ~ freeze(board : Cell, generations : int)
  ~ release()
  ~ beforeTransition(board : Cell) : boolean
  ~ afterGeneration()
  ~ changeState(next : FreezingState)
  ~ holdSnapshot(board : Cell) : boolean
  ~ isFrozen() : boolean
}

interface FreezingState <<interface>> {
  + beforeTransition(region : FreezingRegion, board : Cell) : boolean
  + afterGeneration(region : FreezingRegion)
  + isFrozen() : boolean
  + remainingGenerations() : int
}

class NormalState {
  ~ {static} INSTANCE : NormalState
  + beforeTransition(region : FreezingRegion, board : Cell) : boolean
  + afterGeneration(region : FreezingRegion)
  + isFrozen() : boolean
  + remainingGenerations() : int
}

class FrozenState {
  - remaining : int
  ~ FrozenState(generations : int)
  + beforeTransition(region : FreezingRegion, board : Cell) : boolean
  + afterGeneration(region : FreezingRegion)
  + isFrozen() : boolean
  + remainingGenerations() : int
}

Cell <|.. Neighborhood
Cell <|.. Resident
Neighborhood "1" *-up-> "64" Cell : - grid

Life --> "1" Universe : - universe
Universe --> "1" Cell : - outermostCell
Universe --> "1" FreezingTools : - freezingTools
Universe --> "1" PatternTools : - patternTools
Universe ..> FreezingManager : <<create>>\n<<use>>

FreezingTools --> "1" FreezingManager : - manager
FreezingTools --> "0..*" FreezingRegion : - entries
FreezingTools ..> Clock : <<use>>
FreezingManager "1" o--> "0..*" FreezingRegion : - regions
FreezingManager ..> FreezingRegion : <<create>>
FreezingManager --> "1" Cell : - board

FreezingRegion --> "1" FreezingState : - state
FreezingRegion ..> Cell : <<use>>
FreezingRegion ..> FrozenState : <<create>>
FreezingState <|.. NormalState
FreezingState <|.. FrozenState
FrozenState ..> FreezingRegion : <<use>>
FrozenState ..> NormalState : <<use>>

note top of FreezingState : State
note bottom of NormalState : ConcreteState\n값이 없어 객체 하나를 공유
note bottom of FrozenState
  ConcreteState
  beforeTransition()에서 region.holdSnapshot()을 부르고,
  남은 세대가 0이 되면 region.changeState(NormalState.INSTANCE)로
  스스로 바꾼다: Release Freezing Automatically(E)
end note
note left of FreezingRegion
  Context
  고정 중인지 if로 묻지 않고 state에 넘긴다.
  freeze()는 board.isAliveAt()으로 스냅샷을 읽고,
  holdSnapshot()은 board.holdNextState()로 다음 생사를 바꾼다
end note
note right of FreezingTools
  화면 담당
  Select Region(E), Set Duration(E)의 입력을 받아
  manager에 넘긴다. 영역 선택을 시작하면
  beforeSelect를 부르고 Clock.instance().stop()으로 멈춘다.
  manager.addListener(this::refresh)로 변경을 받는다
end note
note right of FreezingManager
  Install Freezing(E) : install()
  Release Freezing(E) : release(), releaseAll(), reset()
  Release Freezing Automatically(E) : afterGeneration()
  listeners에는 FreezingTools.refresh가
  Runnable로만 들어 있다.
  FreezingTools 타입도 Swing도 모른다
end note
note right of Universe
  Mediator
  FreezingManager를 만들어 FreezingTools에 넘기고,
  세대 처리에서 계산과 전이 사이에
  beforeTransition(), 세대 증가 뒤에 afterGeneration()을 부른다.
  FreezingTools에는 Runnable(beforeSelect),
  PatternTools에는 setPlacementGuard()로
  Predicate(배치 가드)만 넘긴다. 두 도구는 서로를 모른다.
  고정 칸: mousePressed는 획을 시작하지 않고
  setCell()은 그 칸을 건너뛴다
end note
@enduml
