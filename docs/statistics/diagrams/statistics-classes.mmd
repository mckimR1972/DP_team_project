---
config:
  flowchart:
    curve: linear
---
classDiagram
    direction TB

    class Life {
        -Universe universe
        -Statistics statistics
        ~connectStatistics(universe, panel)$
        +dispose()
    }
    class Universe {
        -Set~BoardChangeListener~ boardListeners
        -Cell outermostCell
        -long generation
        +addBoardChangeListener(listener)
        +removeBoardChangeListener(listener)
        +notifyBoardChanged(kind)
        +liveCells()
        -createBoardChangeEvent(kind, before)
    }
    class BoardChangeListener {
        <<interface>>
        +onBoardChanged(event)
    }
    class BoardChangeEvent {
        +kind()
        +generation()
        +boardSize()
        +copyAliveCells()
        +copyBirths()
        +copyDeaths()
        +aliveColors()
    }
    class Statistics {
        -Consumer~Summary~ onUpdated
        -Summary currentSummary
        +onBoardChanged(event)
        +current()
        -calculate(event)
    }
    class StatisticsPanel {
        +showStatistics(summary)
    }
    class Summary["Statistics.Summary"] {
        <<record>>
        +generation()
        +livingCells()
        +livingRatio()
        +births()
        +deaths()
        +hasGenerationDelta()
        +colorCounts() List~ColorCount~
    }
    class ColorCount["Statistics.ColorCount"] {
        <<record>>
        +color() Color
        +cells() int
        +ratio() double
    }
    class Cell {
        <<interface>>
        +isAliveAt(row, column)
        +colorAt(row, column)
    }

    Life --> Universe : register / unregister
    Life --> Statistics : create / retain
    Life ..> StatisticsPanel : create / bind callback
    Universe --> BoardChangeListener : store / notify
    Statistics ..|> BoardChangeListener
    Universe --> Cell : outermostCell
    Universe ..> BoardChangeEvent : createBoardChangeEvent
    Statistics ..> BoardChangeEvent : calculate
    Statistics --> Summary : currentSummary
    StatisticsPanel ..> Summary : showStatistics
    Summary --> "0..*" ColorCount : colorCounts
