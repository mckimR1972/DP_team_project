@startuml statistics-use-cases
left to right direction
skinparam linetype polyline
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 18
skinparam dpi 160
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam ArrowColor black
skinparam actorBorderColor black
skinparam actorFontColor black
skinparam rectangleBorderColor black
skinparam rectangleBackgroundColor white
skinparam usecaseBorderColor black
skinparam usecaseBackgroundColor white
skinparam usecaseFontColor black
skinparam nodesep 45
skinparam ranksep 50

actor "Game User" as Player
rectangle "Life Game" {
    usecase "View Color Distribution(E)" as ColorStatistics
    usecase "View Basic Statistics(E)" as BasicStatistics
}
Player -- BasicStatistics
Player -- ColorStatistics
@enduml
